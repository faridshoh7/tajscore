# Скопируйте в .env и впишите свои значения. Сам .env в git не попадает.
# НИКОГДА не кладите настоящие ключи в этот файл — репозиторий публичный.
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Ваш Telegram ID: сюда бот присылает еженедельный бэкап базы и сообщения о новых пользователях
ADMIN_TELEGRAM_ID=
# Веб-админка /adminpanel (Basic Auth). Пустой пароль = админка выключена.
ADMIN_USER=
ADMIN_PASSWORD=
SITE_URL=https://tajscore.duckdns.org
